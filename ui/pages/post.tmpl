{{define "post"}}{{end}}

{{ define "title" }} 
    {{range .PostCards}}
        {{.Posts.Title}} 
    {{end}}
{{ end }}

{{define "content"}}
<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="card shadow-sm border-0">
                {{range .PostCards}}
                
                <div class="card-body p-4 p-md-5">

                    <!-- Title -->
                    <h1 class="mb-3">
                        {{.Posts.Title}}
                    </h1>

                    <!-- Meta -->
                    <div class="text-muted mb-4">
                        Author:
                        <a href="/posts/user/{{.Posts.Username}}"
                           class="badge text-bg-success text-decoration-none">
                            {{.Posts.Username}}
                        </a>

                        <span class="mx-2">•</span>

                        Published:
                        {{.Posts.CreatedAt.Format "02 Jan 2006 15:04"}}
                    </div>

                    <!-- Content -->
                    <div class="post-content fs-5 lh-lg">
                        {{.Posts.Content}}
                    </div>

                    <!-- Actions -->
                    <div class="mt-5 d-flex gap-2">
                        <a href="/"
                           class="btn btn-outline-secondary">
                            Back
                        </a>
                    </div>
                </div>
                {{end}}
            </div>
        </div>
    </div>
</div>
{{end}}