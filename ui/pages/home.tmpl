{{ define "title" }}Homepage{{ end }}

{{define "content"}}
<section class="col-12 p-4">
    
    <div id="posts-table" class="container py-4">
        <div>
            {{template "home-search" . }}
            <div id="posts-container" class="row g-3">
                {{template "posts-list" .}}
            </div>

            <div id="loadmore-container">
                {{template "loadmore" .}}
            </div>
        </div>
    </div>
</section>
{{end}}