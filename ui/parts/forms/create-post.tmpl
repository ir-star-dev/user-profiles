{{ define "form-create-post" }}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <form class="px-3" hx-post="/auth/signup" hx-target="#result" hx-swap="innerHTML"> 
            <h1 class="h3 mb-3 fw-normal">Create post</h1>
            <div id="result" class="my-3"></div>

            <div class="mb-3">
                <input type="text" class="form-control" name="title" required placeholder="Title" minlength="3" maxlength="99">
            </div>
            <div class="mb-3">
                <textarea class="form-control" name="content" placeholder="Content" required>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-success col-12">Create</button>
            </div>
        </form>
    </div>
</div>

{{end}}