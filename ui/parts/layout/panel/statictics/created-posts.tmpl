{{define "created-posts"}}
<div class="col-12 col-lg-7 mb-3">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-4">Created posts</h5>
            <!-- POSTS -->
            <div>
                {{if not (or .Pending .Published) }}
                    You have not created any posts yet.
                {{else}} 
                    {{if .Pending}}
                        <div class="text-muted small text-uppercase mb-2">Pending</div>
                        <div class="table-responsive" style="max-height: 200px;height: 100%;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Title</th>
                                        <th scope="col" class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{range .Pending}}
                                        <tr>
                                            <td>
                                                <a href="/panel/posts/post/{{.Id}}/preview" target="_blank">
                                                {{.Title}}
                                                </a>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning">
                                                    Pending
                                                </span>
                                            </td>
                                        </tr>
                                    {{end}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                         You have no posts waiting for moderation.
                    {{end}}
                    <hr>
                    {{if .Published}}
                        <div class="text-muted small text-uppercase mb-2">Published</div>
                        <div class="table-responsive" style="max-height: 200px;height: 100%;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Title</th>
                                        <th scope="col" class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{range .Published}}
                                        <tr>
                                            <td>
                                                <a href="/posts/post/{{.Slug}}" target="_blank">
                                                {{.Title}}
                                                </a>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success">
                                                    Published
                                                </span>
                                            </td>
                                        </tr>
                                    {{end}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        You have no published posts.
                    {{end}}
                
                {{end}}
            </div>
        </div>
    </div>
</div>
{{end}}