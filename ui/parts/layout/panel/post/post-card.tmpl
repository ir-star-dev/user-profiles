{{define "post-card"}}
<div id="post-{{.Posts.Post.Id}}" class="card-body p-4 p-md-5">
    <!-- Title -->
    <h1 class="mb-3">{{.Posts.Post.Title}}</h1>
    <!-- Meta -->
    <div class="text-muted mb-4">
        Author:
        <a href="/posts/user/{{.Posts.Post.Username}}"
            class="badge text-bg-success text-decoration-none">
            {{.Posts.Post.Username}}
        </a>
        <span class="mx-2">•</span>
        Created:
        {{.Posts.Post.CreatedAt.Format "02 Jan 2006 15:04"}}
        <span class="mx-2">•</span>
        Status:
        {{ if not .Posts.Post.Approved }}
        <span class="badge text-bg-warning">Pending</span>
        {{else}}
        <span class="badge text-bg-success">Published</span>
        {{end}}
    </div>

    <!-- Content -->
    <div class="post-content fs-5 lh-lg">
        {{.Posts.Post.Content}}
    </div>
    <!-- Actions -->
    <div class="mt-5 d-flex gap-2">
        <a href="/panel/posts"
            class="btn btn-outline-secondary">
            Back to Posts
        </a>
        <a href="/panel/posts/post/{{.Posts.Post.Id}}/edit"
            class="btn btn-outline-primary">
            Edit
        </a>

        {{ if .Posts.Post.Approved }}
            <a
                hx-patch="/panel/posts/post/{{.Posts.Post.Id}}/review?view=card"
                hx-target="#post-{{.Posts.Post.Id}}"
                hx-swap="outerHTML"
                class="btn btn-outline-secondary">
                Review
            </a>
        {{ else }}
            <a
                hx-patch="/panel/posts/post/{{.Posts.Post.Id}}/publish?view=card"
                hx-target="#post-{{.Posts.Post.Id}}"
                hx-swap="outerHTML"
                class="btn btn-outline-secondary">
                Publish
            </a>
        {{ end }}
    </div>
</div>              
{{end}}