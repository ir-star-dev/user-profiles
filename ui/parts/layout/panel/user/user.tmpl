{{ define "title" }} Profile {{ end }}

{{ define "user"}}
<section class="col-12 col-md-9 col-lg-12 p-4">
    {{if .UserCards}}
        {{$page := .}}
        {{range .UserCards}}
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <div>
                    <h1 class="h3 mb-1">
                        {{if eq $page.RequestedUserId $page.CurrentUserId}}My Profile{{else}}{{.Profiles.Name}} Profile{{end}}
                    </h1>
                    <p class="text-muted mb-0">
                        View profile and statistics
                    </p>
                </div>
            </div>
            <div class="row">
                {{template "user-card" .}}
                {{template "stats" $page}}
            </div>
        </div>
        {{end}}
    {{end}}

</section>
{{end}}
