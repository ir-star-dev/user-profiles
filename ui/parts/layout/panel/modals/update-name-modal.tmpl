{{ define "update-name-modal" }}

<div id="update-name-modal-container">
    <div class="modal fade" id="updateNameModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            {{if .UserCards}}
                {{range .UserCards}}
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Update name</h5>

                        <button type="button"  class="btn-close"  data-bs-dismiss="modal"></button>
                    </div>

                    <form
                        hx-patch="/panel/profile/{{.Profiles.User.Id}}/name"
                        hx-target="body"
                        hx-swap="innerHTML">
                        <div class="modal-body">
                            <input type="text" name="name" value="{{.Profiles.User.Name}}" class="form-control" required minlength="3">
                        </div>

                        <div class="modal-footer">
                            <button  type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button  type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
                {{end}}
            {{end}}
        </div>
    </div>
</div>
{{ end }}