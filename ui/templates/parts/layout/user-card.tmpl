{{define "user-card"}}
<div id="user-{{.Profile.Id}}" class="col-12 col-lg-6 mb-3">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-start mb-3">
            
            <div>
                <h5 class="card-title mb-1">{{.Profile.Name}}</h5>
                <div class="text-muted small">{{.Profile.Email}}</div>
            </div>

            <!-- BANNED STATUS -->
            <div id="div-badge-{{.Profile.Id}}" style="text-align: end;">
                <span class="badge text-bg-{{if .Profile.Banned}}danger{{else}}success{{end}}" >
                    {{if .Profile.Banned}} Banned  {{else}} Active {{end}}
                </span>
                <div class="text-muted small">Created At: {{.Profile.CreatedAt.Format "02 Jan 2006"}}</div>
            </div>

            </div>

            <hr>
            <!-- ACTIONS -->
            <div id="actions-btn-{{.Profile.Id}}" class="d-flex gap-2">
                <a hx-patch="/profile/{{.Profile.Id}}/name" class="btn btn-outline-primary btn-sm w-100">
                    Update name
                </a>
                {{ if ne .Profile.Id .CurrentUserId }}
                    {{if .Profile.Banned}}
                        <a  hx-patch="/profile/{{.Profile.Id}}/unban"
                            hx-target="#user-{{.Profile.Id}}"
                            hx-swap="outerHTML"
                            class="btn btn-outline-secondary btn-sm w-100">
                            Unban
                        </a>
                    {{else}}
                        <a  hx-patch="/profile/{{.Profile.Id}}/ban"
                            hx-target="#user-{{.Profile.Id}}"
                            hx-swap="outerHTML"
                            class="btn btn-outline-secondary btn-sm w-100">
                            Ban
                        </a>
                    {{end}}
                    {{if eq .Profile.Id .CurrentUserId}}
                    <a hx-delete="/{{.Profile.Id}}" class="btn btn-outline-danger btn-sm w-100">
                        Delete
                    </a>
                    {{else}}
                    <a  hx-target="#user-{{.Profile.Id}}"
                        hx-swap="outerHTML"
                        hx-delete="/profile/{{.Profile.Id}}" class="btn btn-outline-danger btn-sm w-100">
                        Delete
                    </a>
                    {{end}}
                {{end}}
            </div>
        </div>
    </div>
</div>
{{end}}